# Public site URL (SEO, sitemap, Open Graph, Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SECRET=change-me-random-secret

# OpenAI — pattern text, translations, product images
OPENAI_API_KEY=sk-...

# Text model (design spec + pattern JSON + FR/ES)
OPENAI_CONTENT_MODEL=gpt-5-mini

# Image model (finished crochet item photos — Flare)
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=auto

# Default paid pattern price (USD; cents for Stripe unit_amount)
DEFAULT_CURRENCY=usd
DEFAULT_PRICE_CENTS=499

# Stripe Checkout (test keys for local; live for production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook endpoint: POST /api/stripe/webhook
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
