# Public site URL (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SECRET=change-me-random-secret

# OpenAI — pattern text, translations, product images
OPENAI_API_KEY=sk-...

# Text model (design spec + pattern JSON + FR/ES)
OPENAI_CONTENT_MODEL=gpt-4o-mini

# Image model (finished crochet item photos)
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1024x1024
